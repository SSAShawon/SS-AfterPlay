# ─────────────────────────────────────────────────────────────
# SS AFTERPLAY — environment configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real key.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (or legacy anon) key — safe for the browser, guarded by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side only. Used exclusively by `npm run create-admin` and other
# privileged maintenance scripts. NEVER reference this from client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# The single account allowed into /admin. Must match the Supabase Auth user.
ADMIN_EMAIL=samsul261103@gmail.com

# Public site URL, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
